#!/bin/bash
# .git/hooks/pre-push
#
# This hook is executed before a push is made.
# It runs comprehensive checks to ensure code quality and security.

# Colors for output (only if outputting to a terminal)
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    NC='\033[0m' # No Color
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    NC=''
fi

echo "${BLUE}🚀 Running pre-push checks...${NC}"

# CRITICAL: Prevent direct pushes to main/master branches (except Heroku deployments)
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
REMOTE_NAME="$1"

# Allow pushes to Heroku remote (for deployments)
if [ "$REMOTE_NAME" != "heroku" ] && ([ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "master" ]); then
    echo "${RED}❌ ERROR: Direct pushes to '$CURRENT_BRANCH' branch are not allowed!${NC}"
    echo "${RED}Please create a feature branch and use a pull request instead.${NC}"
    echo ""
    echo "${YELLOW}To fix this:${NC}"
    echo "  1. Create a new branch: git checkout -b feature/your-feature-name"
    echo "  2. Make your changes and commit"
    echo "  3. Push the branch: git push origin feature/your-feature-name"
    echo "  4. Create a pull request to merge into $CURRENT_BRANCH"
    echo ""
    exit 1
fi

# Load shared functions
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/shared/security-check.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/shared/personal-data-check.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/shared/quality-checks.sh"

# Launch post-push detached. pre-push must not call GitHub and must not wait
# on the GitHub API. The push still runs the secret, main/master, and test checks.
launch_pr_refresh() {
    local hook line sha branch launched
    hook="$SCRIPT_DIR/post-push"
    [ -f "$hook" ] || return 0
    [ -n "$PR_REFRESH_REFS" ] || return 0
    launched=0

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        sha="${line%% *}"
        branch="${line#* }"
        launched=1
        if command -v python3 >/dev/null 2>&1; then
            # Double-fork into a new session so git does not wait on this process.
            python3 -c 'import os, signal, sys
signal.signal(signal.SIGHUP, signal.SIG_IGN)
if os.fork() > 0:
    os._exit(0)
os.setsid()
if os.fork() > 0:
    os._exit(0)
os.execv(sys.argv[1], sys.argv[1:])' "$hook" "$REMOTE_NAME" "$sha" "$branch" </dev/null >/dev/null 2>&1 || true
        elif command -v perl >/dev/null 2>&1; then
            perl -e 'use POSIX; $SIG{HUP}="IGNORE"; fork and exit; setsid; fork and exit; exec @ARGV or exit 0' "$hook" "$REMOTE_NAME" "$sha" "$branch" </dev/null >/dev/null 2>&1 || true
        else
            nohup "$hook" "$REMOTE_NAME" "$sha" "$branch" </dev/null >/dev/null 2>&1 &
            disown $! 2>/dev/null || true
        fi
    done <<< "$PR_REFRESH_REFS"

    if [ "$launched" -eq 1 ]; then
        echo "${YELLOW}💡 Open pull request text refreshes after this push. GitHub is not contacted from pre-push.${NC}"
    fi
    return 0
}

# CRITICAL: Check for sensitive data in commits being pushed.
# Kaloko runs only when this push updates main or master. Feature-branch
# pushes and Heroku deploys skip it. Deleting a remote branch does not count.
COMMITS_TO_CHECK=""
PUSHES_MAIN=false
PR_REFRESH_REFS=""
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
        COMMITS_TO_CHECK="$COMMITS_TO_CHECK $local_sha"
        case "$remote_ref" in
            refs/heads/main|refs/heads/master)
                PUSHES_MAIN=true
                ;;
            refs/heads/*)
                PR_REFRESH_REFS="${PR_REFRESH_REFS}${local_sha} ${remote_ref#refs/heads/}"$'\n'
                ;;
        esac
    fi
done

if ! check_commits "$COMMITS_TO_CHECK"; then
    exit 1
fi

if ! check_personal_data_commits "$COMMITS_TO_CHECK"; then
    exit 1
fi

echo "${YELLOW}💡 TypeScript and linting checks already passed in pre-commit${NC}"

# Detect Heroku push (by remote name or URL)
REMOTE_URL=$(git remote get-url "$REMOTE_NAME" 2>/dev/null || git remote get-url heroku 2>/dev/null)
IS_HEROKU_PUSH=false
if [ "$REMOTE_NAME" = "heroku" ] || echo "$REMOTE_URL" | grep -q "heroku"; then
    IS_HEROKU_PUSH=true
fi

if [ "$IS_HEROKU_PUSH" = true ]; then
    echo "${BLUE}🎯 Pushing to Heroku - skipping local tests${NC}"
    echo "${YELLOW}💡 Run tests against the deployed app after deploy if needed${NC}"
    echo "${BLUE}🎯 Ensuring production readiness...${NC}"
    if ! run_build_check; then
        exit 1
    fi
else
    if ! run_tests; then
        exit 1
    fi
    if [ "$PUSHES_MAIN" = true ]; then
        if ! run_kaloko_if_available; then
            exit 1
        fi
    else
        echo "${YELLOW}⚠️  Skipping Kaloko (runs only when merging to main or master)${NC}"
    fi
fi

# Do not call GitHub here. A failed or slow refresh must not block the push.
if [ "$IS_HEROKU_PUSH" != true ]; then
    launch_pr_refresh || true
fi

echo "${GREEN}🎉 All pre-push checks passed!${NC}"
exit 0
